<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpShorts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- Phase 17: skeleton placeholder for the initial feed load
         (ShortsViewModel.isLoading), replacing the previous bare
         ProgressBar. Deliberately doesn't cover isLoadingMore
         (pagination) — that state already has visible feed content
         behind it, so a full-screen skeleton there would hide real
         items rather than stand in for missing ones; it also had no UI
         before this phase and adding one is outside Phase 17's DoD
         (which is about the screens' own load, not every subsequent
         page fetch), so it's left as a known gap rather than silently
         bundled in here. -->
    <LinearLayout
        android:id="@+id/skeletonShorts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom|start"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <View
            android:layout_width="220dp"
            android:layout_height="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />

    </LinearLayout>

    <!-- Phase 16: cache-fallback indicator — see ShortsFeedRepository.FeedPage
         and ShortsViewModel.isOffline doc comments for exactly when this
         shows. Deliberately says "cached" rather than "offline": the same
         fallback also fires when every source is simultaneously backed off
         (Phase 15) with network present, and this banner should stay
         accurate in that case too, not just the network-down case. -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/cobalt_surface_elevated"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/shorts_showing_cached"
        android:textColor="@color/cobalt_text_primary"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

</FrameLayout>
