<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cobalt_surface_sidebar"
    android:minHeight="160dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@color/cobalt_input_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:text="@string/quality_picker_title"
        android:textColor="@color/cobalt_text_primary"
        android:fontFamily="@font/ibm_plex_mono_regular"
        android:textSize="14sp" />

    <!-- Phase 20: two-way toggle between the video ladder and the audio
         ladder (TranscodeProfile.ALL_VIDEO / ALL_AUDIO). Which group is
         shown first depends on whether the source ResolvedFormat the user
         picked in ResolutionPickerDialog was itself video or audio — see
         QualitySelectionSheet.onViewCreated — but both are always
         reachable, since a user may want to pull just the audio track out
         of a video-format source, or vice versa isn't offered (ffmpeg
         can't synthesize video from an audio-only source). -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleKind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <Button
            android:id="@+id/btnKindVideo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/quality_kind_video"
            android:textSize="12sp"
            android:fontFamily="@font/ibm_plex_mono_regular" />

        <Button
            android:id="@+id/btnKindAudio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/quality_kind_audio"
            android:textSize="12sp"
            android:fontFamily="@font/ibm_plex_mono_regular" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
