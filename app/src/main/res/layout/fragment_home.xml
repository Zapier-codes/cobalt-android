<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Paste-link / search entry bar. Distinct from the Shorts feed screen. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLinkInput"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Paste a link to download"
        app:endIconMode="clear_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLinkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Resolve"
        app:layout_constraintTop_toBottomOf="@id/tilLinkInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Honest scaffolding: LinkResolverRepository doesn't exist until Phase 4,
         so this surfaces a real "not implemented yet" state rather than
         faking a network response. -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnSubmit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reserved for the recent/trending feed — populated starting in a
         later phase once there's a real feed source for it. Empty on
         purpose for now, not a fake list. -->
    <FrameLayout
        android:id="@+id/feedContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Phase 17: skeleton placeholder shown while HomeViewModel.isResolving
         is true. Home has no other "data load" yet (feedContainer above is
         still reserved/empty per Phase 3), so this is the resolve-in-flight
         state the DoD's "while their data loads" refers to here — three
         rows foreshadowing the resolution-picker rows Phase 6 shows once
         the resolve succeeds. Occupies the same reserved area as
         feedContainer; the two are mutually exclusive by visibility, never
         both visible at once. -->
    <LinearLayout
        android:id="@+id/skeletonResolving"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_skeleton_block" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
